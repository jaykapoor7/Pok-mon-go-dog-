{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "demo": true
    }
  },
  "crons": [
    {
      "path": "/api/admin/spatial/refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/admin/kaju/checks",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/automations/run",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/admin/notifications/deliver",
      "schedule": "45 4 * * *"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore.sh"
}
