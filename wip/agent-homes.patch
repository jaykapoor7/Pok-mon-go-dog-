+.nx .hm-task .nx-check { flex: none; position: relative; min-height: 0; }
+.nx .hm-task .nx-check::after { content: ""; position: absolute; inset: -8px; }
+.nx .hm-task-t { flex: 1 1 auto; display: grid; min-width: 0; }
+.nx .hm-task.is-done .hm-task-t b { color: var(--hm-mute); text-decoration: line-through; text-decoration-color: var(--hm-line); }
+.nx .hm-task-x { flex: none; width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; color: var(--hm-mute); }
+.nx .hm-task-x:hover { background: var(--hm-flame-soft); color: var(--hm-flame-ink); }
+.nx .hm-note { color: var(--hm-mute); font-size: 12px; line-height: 16px; }
+.nx .hm-note.is-bad { color: var(--hm-flame-ink); }
+.nx .hm-link { color: var(--hm-blue); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
+.nx .hm-foot-note { margin-top: 16px; max-width: 72ch; }
+
+/* ── A short row of cards (what Kaju is waiting on) ──────────────── */
+.nx .hm-strip { margin-top: 32px; color: var(--hm-body); font-size: 14px; line-height: 20px; }
+.nx .hm-strip-h { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; min-height: 40px; }
+.nx .hm-strip-h h2 { margin: 0; color: var(--hm-ink); font-size: 16px; line-height: 24px; font-weight: 600; }
+.nx .hm-strip-h .hm-all { margin-left: auto; }
+.nx .hm-strip-none { color: var(--hm-body); }
+.nx .hm-skel.is-line { width: 240px; height: 16px; }
+.nx .hm-strip-l { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.nx .hm-strip-l > li { display: grid; min-width: 0; }
+.nx .hm-card { display: grid; grid-template-columns: 32px minmax(0, 1fr); align-items: start; gap: 12px; padding: 16px; border-radius: 16px; background: var(--hm-fill); transition: background .2s var(--hm-ease), transform .2s var(--hm-ease); }
+.nx a.hm-card:hover { background: var(--hm-fill-2); transform: translateY(-1px); }
+
+/* A wide chart section beside a breakdown (sample programme insights) */
+.nx .hm-wide { margin-top: 32px; }
+
+/* ── Smaller screens ─────────────────────────────────────────────── */
+@media (max-width: 1180px) {
+  .nx .hm-grid.is-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .nx .hm-grid.is-3 > :last-child:nth-child(odd) { grid-column: 1 / -1; }
+}
+@media (max-width: 900px) {
+  .nx .hm-grid.is-2, .nx .hm-grid.is-3 { grid-template-columns: minmax(0, 1fr); }
+  .nx .hm-grid.is-3 > :last-child:nth-child(odd) { grid-column: auto; }
+  .nx .hm-strip-l { grid-template-columns: minmax(0, 1fr); gap: 8px; }
+}
+@media (max-width: 640px) {
