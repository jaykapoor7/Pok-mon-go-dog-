+@keyframes hm-flow { from { background-position: 200% 0; } to { background-position: -200% 0; } }
+
+/* ── Tasks on a home ─────────────────────────────────────────────── */
+.nx .hm-add { display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 12px; border-radius: 8px; background: var(--hm-raise); box-shadow: inset 0 0 0 1px var(--hm-line); color: var(--hm-mute); }
