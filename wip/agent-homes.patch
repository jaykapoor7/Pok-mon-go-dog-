+  if (self && body === null) { me = true; body = self[1]; }
+  pick(q.match(/^(?:add|put)\s+(.+?)\s+(?:to|on|in)\s+(?:my|our|the)\s+(?:task|to-?do|todo|tasks)?\s*list$/i), null, 1);
