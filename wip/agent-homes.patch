+.nx .hm-strip-h .hm-all { margin-left: auto; }
+.nx .hm-strip-none { color: var(--hm-body); }
+.nx .hm-skel.is-line { width: 240px; height: 16px; }
+.nx .hm-strip-l { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.nx .hm-strip-l > li { display: grid; min-width: 0; }
+.nx .hm-card { display: grid; grid-template-columns: 32px minmax(0, 1fr); align-items: start; gap: 12px; padding: 16px; border-radius: 16px; background: var(--hm-fill); transition: background .2s var(--hm-ease), transform .2s var(--hm-ease); }
+.nx a.hm-card:hover { background: var(--hm-fill-2); transform: translateY(-1px); }
+
+/* A wide chart section beside a breakdown (sample programme insights) */
+.nx .hm-wide { margin-top: 32px; }
+
+/* ── Smaller screens ─────────────────────────────────────────────── */
+@media (max-width: 1180px) {
+  .nx .hm-grid.is-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .nx .hm-grid.is-3 > :last-child:nth-child(odd) { grid-column: 1 / -1; }
+}
+@media (max-width: 900px) {
+  .nx .hm-grid.is-2, .nx .hm-grid.is-3 { grid-template-columns: minmax(0, 1fr); }
+  .nx .hm-grid.is-3 > :last-child:nth-child(odd) { grid-column: auto; }
+  .nx .hm-strip-l { grid-template-columns: minmax(0, 1fr); gap: 8px; }
+}
+@media (max-width: 640px) {
+  .nx .hm-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 16px; }
+  .nx .hm-tile { min-height: 128px; padding: 12px; border-radius: 12px; }
+  .nx .hm-tile-n { font-size: 24px; line-height: 32px; min-height: 32px; }
+  .nx .hm-grid { gap: 16px; margin-top: 24px; }
+  .nx .hm-panel { padding: 12px 12px 4px; border-radius: 12px; }
+  .nx .hm-row-m { min-height: 56px; }
+  .nx .hm-ask, .nx .hm-task-x { width: 44px; height: 44px; }
+  .nx .hm-all { min-height: 44px; }
+  .nx .hm-add { height: 48px; }
+  .nx .hm-add input { font-size: 16px; }
+  .nx .hm-btn { height: 44px; }
+  .nx .hm-legend { gap: 4px 8px; }
+  .nx .hm-strip { margin-top: 24px; }
+  .nx .hm-strip-l { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 8px -16px 0; padding: 0 16px 4px; gap: 8px; }
+  .nx .hm-strip-l::-webkit-scrollbar { display: none; }
+  .nx .hm-strip-l > li { flex: 0 0 80%; scroll-snap-align: start; }
+  .nx .hm-card { padding: 12px; border-radius: 12px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .nx .hm-track i, .nx .hm-bar i, .nx .hm-skel { animation: none; }
+  .nx .hm-tile, .nx .hm-tile-l svg, .nx .hm-row-m, .nx .hm-card { transition: none; }
+  .nx .hm-tile.is-link:hover, .nx .hm-tile.is-link:hover .hm-tile-l svg, .nx a.hm-card:hover { transform: none; }
+}
