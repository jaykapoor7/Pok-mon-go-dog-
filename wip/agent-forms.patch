+
+/* The manual form, folded under the box on pages that open a record. */
+.nx .kc-page { max-width: 1040px; padding: 24px 32px 48px; display: grid; gap: 24px; align-content: start; }
+.nx .kc-page .nr-form { padding: 0; }
+.nx .kc-fold { display: grid; gap: 16px; }
+.nx .kc-fold[hidden] { display: none; }
+.nx .kc-fold-h { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
