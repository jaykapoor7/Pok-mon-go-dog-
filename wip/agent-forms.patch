+.nx .kc-line { padding: 8px 32px 16px; max-width: 1040px; }
+/* The case's manual note and follow-up, folded under Record by hand (src/nx/pages/ngo/parts.tsx CaseNext). */
+.nx .nr-hand { display: grid; gap: 8px; }
+.nx .nr-hand[hidden] { display: none; }
+
+/* Field mode: Say it, at the top of Record an animal (uses field mode's own colours). */
+.nx:not([data-theme="dark"]) .kc-say { --fm-mute: #586174; }
+.nx .kc-say { display: grid; gap: 12px; padding: 16px; border-radius: 12px; background: var(--fm-fill); }
+.nx .kc-say-l { display: flex; align-items: center; gap: 12px; }
+.nx .kc-say-l > span { display: grid; }
+.nx .kc-say-l b { font-size: 16px; line-height: 24px; }
+.nx .kc-say-l small { font-size: 12px; line-height: 16px; color: var(--fm-mute); }
+.nx .kc-say-r { display: flex; gap: 8px; min-width: 0; }
+.nx .kc-say-r input { flex: 1; min-width: 0; min-height: 48px; padding: 8px 12px; border: 0; border-radius: 8px; background: var(--fm-raise); box-shadow: inset 0 0 0 1px var(--fm-line); color: var(--fm-ink); font: inherit; font-size: 16px; line-height: 24px; }
+.nx .kc-say-r input::placeholder { color: var(--fm-mute); }
+.nx .kc-say-r input:focus-visible { outline: 2px solid var(--fm-blue); outline-offset: 1px; }
+.nx .kc-say-r .fm-btn { height: 48px; background: var(--fm-raise); box-shadow: inset 0 0 0 1px var(--fm-line); }
+.nx .kc-say-o { font-size: 14px; line-height: 20px; color: var(--fm-body); }
+
+@keyframes kc-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
+@media (prefers-reduced-motion: reduce) {
+  .nx .kc-none, .nx .kc-prop { animation: none; }
+  .nx .kc-fold-h .nx-btn svg { transition: none; }
+}
+@media (max-width: 640px) {
+  .nx .kc-page { padding: 16px 16px 64px; gap: 16px; }
+  .nx .kc-line { padding: 8px 16px 16px; }
+  .nx .kc:not(.is-compact) .kc-row { flex-direction: column; align-items: stretch; }
+  .nx .kc:not(.is-compact) .kc-send { justify-content: flex-end; }
+  .nx .kc-in { font-size: 16px; }
+  .nx .kc .nx-btn, .nx .kc-fold-h .nx-btn { height: 48px; }
+  .nx .kc.is-compact .kc-in { min-height: 48px; padding: 12px; }
