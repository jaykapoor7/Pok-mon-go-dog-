+.nx .kc-kind { flex: none; display: inline-flex; align-items: center; gap: 4px; padding: 0 8px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); font-size: 12px; line-height: 20px; font-weight: 600; }
