+  const sexRaw = (pick(o, "sex", "patientSex", "patient_sex") ?? "").toLowerCase();
+  const washRaw = (pick(o, "woundWashed", "wound_washed", "washed", "woundWashing", "wound_washing") ?? "").toLowerCase();
