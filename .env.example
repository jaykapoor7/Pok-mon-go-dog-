# ─────────────────────────────────────────────────────────────
# StrayPaw Delhi, environment variables
#
# Add these in Vercel (Project → Settings → Environment Variables) for the
# live, public app. Locally, copy this file to `.env.local` and fill it in.
#
# With NO Supabase keys the app runs but shows empty data (reads return []).
# For the real launch you want all three NEXT_PUBLIC_ values below set.
# ─────────────────────────────────────────────────────────────

# Supabase (https://app.supabase.com → Project Settings → API)
# These are safe to expose to the browser, writes are guarded by RLS and
# SECURITY DEFINER functions (see supabase/schema.sql). Posting needs no login.
# Sign-in (email magic link) is optional and lets users manage their own
# sightings + dog status from any device, run supabase/auth-accounts.sql and
# set the Site URL under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your canonical site URL (no trailing slash). REQUIRED for the X/Twitter link
# preview image to show. It makes the og:image an absolute URL on your domain.
# e.g. https://straypaw.org
NEXT_PUBLIC_SITE_URL=

# Mapbox GL access token (https://account.mapbox.com/access-tokens/)
# Without this the app renders a stylised, but fully interactive, fallback map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Spam protection (Cloudflare Turnstile, free) ───────────────
# https://dash.cloudflare.com → Turnstile → Add site (get both keys).
# When BOTH are set, the report form requires a human check that is verified
# server-side before any sighting is saved. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only Supabase service role key (Settings → API → service_role).
# Lets the protected /api/report route write after the Turnstile check.
# NEVER prefix this with NEXT_PUBLIC. It must stay server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Admin secret for the moderation endpoint (/api/admin/sightings).
# Any long random string. Used to list/approve/reject pending sightings.
# Requires SUPABASE_SERVICE_ROLE_KEY to be set too. Server-side only.
ADMIN_SECRET=

# Telegram operator alerts (server-side; optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional donation link shown on /donate (UPI/Razorpay/Ko-fi/etc)
NEXT_PUBLIC_DONATE_URL=


# Transactional email (Resend), powers "your sighting is live" emails.
# Leave blank to disable sending (emails are still collected). Needs a verified
# sending domain in Resend, and EMAIL_FROM on that domain.
RESEND_API_KEY=
EMAIL_FROM=

# NOTE: the two keys above send StrayPaw's own email (for example, telling a
# reporter their sighting is live). They do NOT send Supabase Auth's signup
# confirmation or password-reset messages, which go through Supabase's own
# SMTP settings and are configured separately.
#
# Supabase's built-in auth email service only delivers to addresses on your
# own Supabase project team and is capped at 2 messages per hour, so signup
# confirmations sent to an ordinary Gmail or Outlook address never arrive.
# Either:
#   a) turn OFF Authentication > Providers > Email > Confirm email, which is
#      what the signup flow here expects (it signs the new account straight
#      in), or
#   b) set a custom SMTP provider under Authentication > Emails > SMTP
#      Settings (Resend gives SMTP credentials on the same verified domain),
#      then raise Authentication > Rate Limits, which defaults to 30 per hour
#      once custom SMTP is on.
# Password reset needs (b) either way.
