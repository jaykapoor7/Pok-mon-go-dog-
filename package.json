    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^8",
    "eslint-config-next": "^15.5.19",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5"
